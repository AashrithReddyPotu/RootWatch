{
  "$defs": {
    "Deployment": {
      "properties": {
        "deployment_version": {
          "minLength": 1,
          "title": "Deployment Version",
          "type": "string"
        },
        "deployed_at": {
          "format": "date-time",
          "title": "Deployed At",
          "type": "string"
        },
        "commit_hash": {
          "title": "Commit Hash",
          "type": "string"
        },
        "files_changed": {
          "items": {
            "type": "string"
          },
          "title": "Files Changed",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "deployment_version",
        "deployed_at",
        "commit_hash",
        "files_changed",
        "description"
      ],
      "title": "Deployment",
      "type": "object"
    },
    "Incident": {
      "properties": {
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "service": {
          "title": "Service",
          "type": "string"
        },
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "error_type": {
          "title": "Error Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "start_time": {
          "format": "date-time",
          "title": "Start Time",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "occurrence_count": {
          "title": "Occurrence Count",
          "type": "integer"
        },
        "failure_rate": {
          "title": "Failure Rate",
          "type": "number"
        },
        "severity": {
          "enum": [
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "deployment_version": {
          "title": "Deployment Version",
          "type": "string"
        }
      },
      "required": [
        "incident_id",
        "service",
        "endpoint",
        "method",
        "error_type",
        "status",
        "start_time",
        "last_seen",
        "occurrence_count",
        "failure_rate",
        "severity",
        "deployment_version"
      ],
      "title": "Incident",
      "type": "object"
    },
    "ServerLog": {
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "service": {
          "default": "careers-backend",
          "minLength": 1,
          "title": "Service",
          "type": "string"
        },
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ],
          "title": "Method",
          "type": "string"
        },
        "status_code": {
          "maximum": 599,
          "minimum": 100,
          "title": "Status Code",
          "type": "integer"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "error_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "deployment_version": {
          "minLength": 1,
          "title": "Deployment Version",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "endpoint",
        "method",
        "status_code",
        "latency_ms",
        "deployment_version"
      ],
      "title": "ServerLog",
      "type": "object"
    },
    "Statistics": {
      "properties": {
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "total_requests": {
          "title": "Total Requests",
          "type": "integer"
        },
        "failed_requests": {
          "title": "Failed Requests",
          "type": "integer"
        },
        "failure_rate": {
          "title": "Failure Rate",
          "type": "number"
        },
        "average_latency_ms": {
          "title": "Average Latency Ms",
          "type": "number"
        },
        "error_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Error Counts",
          "type": "object"
        }
      },
      "required": [
        "window_start",
        "window_end",
        "total_requests",
        "failed_requests",
        "failure_rate",
        "average_latency_ms",
        "error_counts"
      ],
      "title": "Statistics",
      "type": "object"
    }
  },
  "properties": {
    "incident": {
      "$ref": "#/$defs/Incident"
    },
    "recent_logs": {
      "items": {
        "$ref": "#/$defs/ServerLog"
      },
      "title": "Recent Logs",
      "type": "array"
    },
    "deployment": {
      "anyOf": [
        {
          "$ref": "#/$defs/Deployment"
        },
        {
          "type": "null"
        }
      ]
    },
    "statistics": {
      "$ref": "#/$defs/Statistics"
    }
  },
  "required": [
    "incident",
    "recent_logs",
    "deployment",
    "statistics"
  ],
  "title": "Context",
  "type": "object"
}
